generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// บัญชีสำหรับ "เข้าใช้ dashboard" — คนละเรื่องกับ User ที่เป็นเจ้าของบัตร RFID
/// (คนที่มีบัตรเข้าประตูได้ ไม่จำเป็นต้องเข้า dashboard ได้ และกลับกันด้วย)
model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(64)
  /// รูปแบบ "scrypt:<salt hex>:<hash hex>" — ดู auth/password.ts
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// สมัครเองผ่านหน้าเว็บได้แค่ USER — ADMIN ต้องตั้งจาก CLI (db:add-admin)
  role         Role     @default(USER)
  cardOwner    User?
}

/// ผู้มีสิทธิ์เข้า-ออก 1 คนต่อ 1 บัตร
model User {
  id        Int         @id @default(autoincrement())
  /// UID ของบัตร RFID เก็บเป็น hex ตัวพิมพ์ใหญ่ไม่มีตัวคั่น เช่น "A1B2C3D4"
  uid       String      @unique @db.VarChar(32)
  name      String
  isActive  Boolean     @default(true)
  email     String?     @db.VarChar(254)
  emailNotificationsEnabled Boolean @default(false)
  dashboardAccountId Int? @unique
  dashboardAccount Admin? @relation(fields: [dashboardAccountId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  logs      AccessLog[]
}

/// ประวัติการทาบบัตรทุกครั้ง รวมถึงบัตรที่ไม่รู้จัก (userId เป็น null)
model AccessLog {
  id        Int          @id @default(autoincrement())
  /// เก็บ uid ซ้ำไว้ตรงนี้ด้วย เพราะบัตรที่ไม่รู้จักจะไม่มีแถวใน User ให้อ้างอิง
  /// และถ้าผู้ใช้ถูกลบทีหลัง log ก็ยังต้องบอกได้ว่าบัตรใบไหนมาทาบ
  uid       String       @db.VarChar(32)
  /// ชื่อเจ้าของบัตร ณ ตอนทาบ เก็บไว้แม้บัญชีถูกลบหรือเปลี่ยนชื่อ
  userName  String?      @db.VarChar(191)
  direction Direction
  status    AccessStatus
  /// path ของภาพ มีเฉพาะขาเข้า — ขาออกไม่ถ่ายภาพจึงเป็น null
  imagePath String?      @db.VarChar(255)
  createdAt DateTime     @default(now())
  userId    Int?
  user      User?        @relation(fields: [userId], references: [id])
  emailNotification EmailNotification?

  @@index([createdAt])
  @@index([uid])
  @@index([userId])
}

model EmailNotification {
  id            Int @id @default(autoincrement())
  accessLogId   Int @unique
  accessLog     AccessLog @relation(fields: [accessLogId], references: [id], onDelete: Cascade)
  toEmail       String @db.VarChar(254)
  recipientName String @db.VarChar(191)
  status        EmailNotificationStatus @default(PENDING)
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String? @db.VarChar(500)
  createdAt     DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
}

enum EmailNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// ค่าตรงกับที่ firmware ส่งมาและที่ frontend ใช้แสดงผลเป๊ะ ๆ
/// อย่าเปลี่ยนตัวพิมพ์ ไม่งั้นสัญญาสามฝั่งจะพัง (ดู CLAUDE.md)
enum Direction {
  in
  out
}

enum AccessStatus {
  granted
  denied
}

/// สิทธิ์ของบัญชี dashboard
/// ADMIN = จัดการบัตร/ผู้ใช้ได้ทั้งหมด
/// USER  = ชื่อ role เดิมของ Guard; ดูข้อมูลการเข้าออกได้อย่างเดียว
enum Role {
  ADMIN
  USER
}
